// BOOKAM - Prisma Database Schema
// Database-Ready Architecture (PostgreSQL / Supabase)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ATTENDEE
  ORGANISER
  INFLUENCER
  CONTESTANT
  ADMIN_SUPER
  ADMIN_OPERATIONS
  ADMIN_FINANCE
  ADMIN_MARKETING
  ADMIN_CONTENT
  ADMIN_SUPPORT
}

enum EventStatus {
  DRAFT
  PENDING_REVIEW
  UNDER_REVIEW
  APPROVED
  LIVE
  COMPLETED
  SUSPENDED
  REJECTED
}

enum TicketStatus {
  ACTIVE
  SOLD_OUT
  INACTIVE
  SCHEDULED
}

enum TransactionStatus {
  SUCCESSFUL
  PENDING
  FAILED
  REFUNDED
  CANCELLED
}

enum RefundStatus {
  PENDING_REVIEW
  APPROVED
  DECLINED
}

enum ContestStatus {
  DRAFT
  UPCOMING
  ACTIVE
  PAUSED
  COMPLETED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  fullName      String
  phone         String?
  role          Role           @default(ATTENDEE)
  avatarUrl     String?
  isActive      Boolean        @default(true)
  isVerified    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lastLoginAt   DateTime?
  
  organisations Organiser[]
  influencer    Influencer?
  contestants   Contestant[]
  orders        Order[]
  tickets       TicketHolder[]
  auditLogs     AuditLog[]
  notifications Notification[]
}

model Organiser {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  organisation    String
  brandName       String?
  email           String
  phone           String
  whatsapp        String?
  instagram       String?
  bankName        String?
  accountNumber   String?
  accountName     String?
  isVerified      Boolean     @default(false)
  isSuspended     Boolean     @default(false)
  createdAt       DateTime    @default(now())
  
  events          Event[]
  contests        Contest[]
}

model Event {
  id               String       @id @default(cuid())
  organiserId      String
  organiser        Organiser    @relation(fields: [organiserId], references: [id])
  title            String
  slug             String       @unique
  category         String
  description      String       @db.Text
  date             DateTime
  endDate          DateTime?
  startTime        String
  endTime          String
  gateOpeningTime  String?
  venue            String
  address          String?
  city             String
  state            String
  country          String       @default("Nigeria")
  capacity         Int          @default(1000)
  status           EventStatus  @default(PENDING_REVIEW)
  isFeatured       Boolean      @default(false)
  salesPaused      Boolean      @default(false)
  flyerUrl         String?
  bannerUrl        String?
  exclusiveAgreed  Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  
  tiers            Ticket[]
  orders           Order[]
  ticketHolders    TicketHolder[]
  promoCodes       PromoCode[]
  influencers      Influencer[]
  media            EventMedia[]
}

model EventMedia {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  type      String   // IMAGE, FLYER, LOGO, VIDEO
  url       String
  createdAt DateTime @default(now())
}

model Ticket {
  id            String         @id @default(cuid())
  eventId       String
  event         Event          @relation(fields: [eventId], references: [id])
  name          String
  price         Decimal        @db.Decimal(12, 2)
  quantity      Int
  soldQuantity  Int            @default(0)
  salesStart    DateTime?
  salesEnd      DateTime?
  status        TicketStatus   @default(ACTIVE)
  description   String?
  perks         String?
  createdAt     DateTime       @default(now())
  
  ticketHolders TicketHolder[]
}

model Order {
  id              String            @id @default(cuid())
  userId          String?
  user            User?             @relation(fields: [userId], references: [id])
  eventId         String
  event           Event             @relation(fields: [eventId], references: [id])
  customerName    String
  customerEmail   String
  customerPhone   String?
  totalAmount     Decimal           @db.Decimal(12, 2)
  discountAmount  Decimal           @default(0) @db.Decimal(12, 2)
  serviceCharge   Decimal           @default(0) @db.Decimal(12, 2)
  promoCode       String?
  status          TransactionStatus @default(PENDING)
  paymentRef      String            @unique
  paymentMethod   String            @default("BANK_TRANSFER")
  createdAt       DateTime          @default(now())
  
  transactions    Transaction[]
  ticketHolders   TicketHolder[]
}

model TicketHolder {
  id            String       @id @default(cuid())
  ticketId      String
  ticket        Ticket       @relation(fields: [ticketId], references: [id])
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id])
  eventId       String
  event         Event        @relation(fields: [eventId], references: [id])
  userId        String?
  user          User?        @relation(fields: [userId], references: [id])
  customerName  String
  customerEmail String
  customerPhone String?
  ticketCode    String       @unique
  qrCodeUrl     String?
  isCheckedIn   Boolean      @default(false)
  checkedInAt   DateTime?
  checkedInGate String?
  isVoid        Boolean      @default(false)
  createdAt     DateTime     @default(now())
}

model Influencer {
  id              String      @id @default(cuid())
  userId          String?     @unique
  user            User?       @relation(fields: [userId], references: [id])
  eventId         String
  event           Event       @relation(fields: [eventId], references: [id])
  name            String
  username        String      @unique
  email           String
  phone           String?
  promoCode       String      @unique
  discountPercent Decimal     @default(10) @db.Decimal(5, 2)
  commPercent     Decimal     @default(10) @db.Decimal(5, 2)
  clicks          Int         @default(0)
  ticketsSold     Int         @default(0)
  revenue         Decimal     @default(0) @db.Decimal(12, 2)
  commEarned      Decimal     @default(0) @db.Decimal(12, 2)
  bankName        String?
  accountNumber   String?
  accountName     String?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
}

model PromoCode {
  id              String      @id @default(cuid())
  code            String      @unique
  eventId         String
  event           Event       @relation(fields: [eventId], references: [id])
  discountPercent Decimal     @db.Decimal(5, 2)
  commPercent     Decimal     @default(0) @db.Decimal(5, 2)
  promoterName    String?
  usesCount       Int         @default(0)
  ticketsSold     Int         @default(0)
  revenue         Decimal     @default(0) @db.Decimal(12, 2)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
}

model Transaction {
  id              String            @id @default(cuid())
  orderId         String
  order           Order             @relation(fields: [orderId], references: [id])
  paymentRef      String            @unique
  amount          Decimal           @db.Decimal(12, 2)
  fee             Decimal           @default(0) @db.Decimal(12, 2)
  netAmount       Decimal           @db.Decimal(12, 2)
  gateway         String            @default("MONIEPOINT")
  status          TransactionStatus @default(PENDING)
  proofUrl        String?
  confirmedAt     DateTime?
  confirmedBy     String?
  createdAt       DateTime          @default(now())
  
  refunds         Refund[]
}

model Refund {
  id              String            @id @default(cuid())
  transactionId   String?
  transaction     Transaction?      @relation(fields: [transactionId], references: [id])
  ticketCode      String?
  customerName    String
  customerEmail   String
  amount          Decimal           @db.Decimal(12, 2)
  reason          String
  bankName        String?
  accountNumber   String?
  accountName     String?
  status          RefundStatus      @default(PENDING_REVIEW)
  reviewedBy      String?
  reviewedAt      DateTime?
  adminNotes      String?
  createdAt       DateTime          @default(now())
}

model Contest {
  id              String         @id @default(cuid())
  organiserId     String
  organiser       Organiser      @relation(fields: [organiserId], references: [id])
  title           String
  description     String?        @db.Text
  bannerUrl       String?
  startDate       DateTime
  endDate         DateTime
  pricePerVote    Decimal        @default(50) @db.Decimal(10, 2)
  status          ContestStatus  @default(ACTIVE)
  createdAt       DateTime       @default(now())
  
  contestants     Contestant[]
}

model Contestant {
  id              String         @id @default(cuid())
  contestId       String
  contest         Contest        @relation(fields: [contestId], references: [id])
  userId          String?
  user            User?          @relation(fields: [userId], references: [id])
  name            String
  code            String
  photoUrl        String?
  bio             String?
  votesCount      Int            @default(0)
  revenue         Decimal        @default(0) @db.Decimal(12, 2)
  rank            Int            @default(1)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
}

model AuditLog {
  id          String    @id @default(cuid())
  adminId     String?
  admin       User?     @relation(fields: [adminId], references: [id])
  adminEmail  String
  action      String
  entity      String
  entityId    String?
  details     String?   @db.Text
  ipAddress   String?
  status      String    @default("SUCCESS")
  createdAt   DateTime  @default(now())
}

model Notification {
  id          String              @id @default(cuid())
  userId      String?
  user        User?               @relation(fields: [userId], references: [id])
  title       String
  message     String              @db.Text
  recipient   String
  channel     NotificationChannel @default(IN_APP)
  status      String              @default("SENT")
  isRead      Boolean             @default(false)
  createdAt   DateTime            @default(now())
}

model PlatformSetting {
  key         String    @id
  value       String    @db.Text
  updatedAt   DateTime  @updatedAt
}
